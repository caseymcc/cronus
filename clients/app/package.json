{
  "name": "@cronus/app",
  "version": "1.0.0",
  "description": "Standalone Electron wrapper for Cronus web client",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && cd ../web && npm run build && cd ../app && npm run copy-web-build",
    "copy-web-build": "rm -rf renderer && mkdir -p renderer && cp -r ../web/build/* renderer/",
    "build:electron-only": "tsc",
    "start": "npm run build && electron . --no-sandbox",
    "dev": "npm run build && electron . --dev --no-sandbox",
    "package": "npm run build && electron-builder"
  },
  "keywords": ["cronus", "electron", "standalone"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@cronus/shared": "file:../shared",
    "@cronus/shared-ui": "file:../shared-ui"
  },
  "build": {
    "appId": "com.cronus.app",
    "productName": "Cronus",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development"
    }
  }
}
