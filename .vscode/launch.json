{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Cronus",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux_x64_debug/server/cronus/cronus",
            "args": [
                "--resource-dir" ,"${workspaceFolder}/server/cronus/resources",
            ],
            "stopAtEntry": false,
            "cwd": "/home/caseymcc/projects/test_snake",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "${workspaceFolder}/build/linux_x64_debug:$LD_LIBRARY_PATH"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "sourceFileMap": {
                "/app": "${workspaceFolder}"
            }
        }
    ]
}
